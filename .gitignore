# Sub-repos: tienen su propio .git y remote.
# El workspace coordinador NO trackea el contenido de los sub-repos.
pld-api/
pld-web/

# Dependencias
node_modules/

# Secrets y env locales
.env
.env.local
.env.*.local

# Jarvis runtime
.jarvis/ui-port

# Logs / tmp / cache
*.log
.DS_Store
.vscode/
.idea/
/tmp/
/dist/

# Configs locales de Claude no-compartibles
.claude/settings.local.json

# Worktrees transitorios de agentes
.claude/worktrees/

# Runtime state de las skills stack-* (PID + logs del proceso Vite local)
.stack/

# Cache del MCP de Playwright (snapshots accessibility + console logs por sesión)
.playwright-mcp/

# Telemetría OTEL — datos persistidos en Docker named volumes (prom-data,
# grafana-data). Defensa por si alguien cambia los volúmenes a bind mounts.
otel/data/
otel/**/data/
otel/**/*.db
otel/**/*.db-wal
otel/**/*.db-shm

# Archivos internos de trabajo (BE-only)
# Estos SÍ se trackean intencionalmente (contexto vivo del equipo):
# - .claude/CHECKLIST_MIGRACION.md
# - .claude/DECISIONES_MIGRACION.md
# Si más adelante se quiere que sean privados, mover acá.

.dist/
.backups/